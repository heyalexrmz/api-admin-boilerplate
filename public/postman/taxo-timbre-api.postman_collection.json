{
  "info": {
    "name": "Taxo Timbre API",
    "description": "Referencia de Taxo Timbre API v1. Usa una llave test para probar los envíos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.taxotimbre.com",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "sk_test_xxx",
      "type": "string"
    },
    {
      "key": "ticket_id",
      "value": "4b96e5de-69de-4dc8-aad7-4d5045fa5b31",
      "type": "string"
    },
    {
      "key": "tax_id",
      "value": "DORA990310A30",
      "type": "string"
    },
    {
      "key": "ticket_image_base64",
      "value": "",
      "type": "string"
    },
    {
      "key": "csf_pdf_base64",
      "value": "",
      "type": "string"
    },
    {
      "key": "taxpayer",
      "value": "Empresa Demo",
      "type": "string"
    },
    {
      "key": "taxpayer_name",
      "value": "ALEJANDRO",
      "type": "string"
    },
    {
      "key": "taxpayer_last_name",
      "value": "DOMINGUEZ",
      "type": "string"
    },
    {
      "key": "taxpayer_second_last_name",
      "value": "RAMIREZ",
      "type": "string"
    },
    {
      "key": "postal_code",
      "value": "01234",
      "type": "string"
    },
    {
      "key": "invoice_fiscal_regimen",
      "value": "612",
      "type": "string"
    },
    {
      "key": "invoice_cfdi_use",
      "value": "G03",
      "type": "string"
    },
    {
      "key": "country",
      "value": "México",
      "type": "string"
    },
    {
      "key": "taxpayer_type",
      "value": "persona_fisica",
      "type": "string"
    },
    {
      "key": "create_ticket_payload",
      "value": "{}",
      "type": "string"
    },
    {
      "key": "idempotency_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "destination_id",
      "value": "00000000-0000-4000-8000-000000000001",
      "type": "string"
    },
    {
      "key": "document_url",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('idempotency_key')) {",
                  "  throw new Error('Set idempotency_key to a stable value before submitting.');",
                  "}",
                  "",
                  "const taxpayerType = pm.collectionVariables.get('taxpayer_type') || 'persona_fisica';",
                  "",
                  "const payload = {",
                  "  tax_id: pm.collectionVariables.get('tax_id'),",
                  "  country: pm.collectionVariables.get('country'),",
                  "  postal_code: pm.collectionVariables.get('postal_code'),",
                  "  invoice_fiscal_regimen: pm.collectionVariables.get('invoice_fiscal_regimen'),",
                  "  invoice_cfdi_use: pm.collectionVariables.get('invoice_cfdi_use'),",
                  "  csf_pdf: pm.collectionVariables.get('csf_pdf_base64'),",
                  "  file: pm.collectionVariables.get('ticket_image_base64'),",
                  "};",
                  "",
                  "if (taxpayerType === 'persona_moral') {",
                  "  payload.taxpayer = pm.collectionVariables.get('taxpayer');",
                  "} else {",
                  "  payload.taxpayer_name = pm.collectionVariables.get('taxpayer_name');",
                  "  payload.taxpayer_last_name = pm.collectionVariables.get('taxpayer_last_name');",
                  "  payload.taxpayer_second_last_name = pm.collectionVariables.get('taxpayer_second_last_name');",
                  "  payload.taxpayer = [",
                  "    payload.taxpayer_name,",
                  "    payload.taxpayer_last_name,",
                  "    payload.taxpayer_second_last_name,",
                  "  ].filter(Boolean).join(' ');",
                  "}",
                  "",
                  "for (const [key, value] of Object.entries(payload)) {",
                  "  if (value === undefined || value === null || String(value).trim() === '') {",
                  "    delete payload[key];",
                  "  }",
                  "}",
                  "",
                  "pm.collectionVariables.set('create_ticket_payload', JSON.stringify(payload, null, 2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{create_ticket_payload}}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets"
              ]
            },
            "description": "Acepta la imagen para facturación asíncrona. Un envío nuevo en modo live consume un crédito. En modo test se simula el resultado. Con el servicio degradado, la respuesta incluye delayed: true. Ajusta taxpayer_type y los datos fiscales. Genera idempotency_key una vez por ticket y úsala de nuevo al reintentar."
          },
          "description": "Single create-ticket endpoint for persona fisica and persona moral RFCs. Change taxpayer_type to persona_fisica or persona_moral before sending."
        },
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets?limit=25&status=finalized",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "status",
                  "value": "finalized",
                  "description": "received, queued, pending, processing, finalized, failed, not_invoiceable, or cancelled"
                }
              ]
            },
            "description": "List recent tickets. Requires a read, admin, or access API key."
          }
        },
        {
          "name": "List tickets - Invalid API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets?limit=25&status=finalized",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                },
                {
                  "key": "status",
                  "value": "finalized",
                  "description": "received, queued, pending, processing, finalized, failed, not_invoiceable, or cancelled"
                }
              ]
            },
            "description": "Editable failure request for validating invalid API key handling.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid_api_key",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Get ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/{{ticket_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "{{ticket_id}}"
              ]
            },
            "description": "Fetch one ticket by id, including invoice and document references when available."
          }
        },
        {
          "name": "Get ticket - Not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tickets",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "Editable failure request for validating ticket not found handling."
          }
        },
        {
          "name": "Registrar solicitud de actualización",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/refresh",
            "description": "Ruta reservada. Responde 202 y registra un trabajo sin actualizar el ticket. Usa la consulta del ticket para recuperar el estado actual."
          }
        },
        {
          "name": "Registrar solicitud de reentrega",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/tickets/{{ticket_id}}/redeliver",
            "description": "Ruta reservada. Responde 202 y registra un trabajo sin reenviar el webhook."
          }
        },
        {
          "name": "Descargar un documento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{document_url}}",
            "description": "Usa la URL firmada completa devuelta en el ticket o webhook. Al vencer, consulta el ticket para obtener otra.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Servicio y consumo",
      "item": [
        {
          "name": "Consultar disponibilidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/status",
            "description": "Devuelve el peor estado medido de ingest, extraction e invoicing para el modo de la llave. Un resultado down todavía devuelve HTTP 200. Trata un timeout o 5xx como indisponibilidad."
          }
        },
        {
          "name": "Consultar estadísticas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/stats",
            "description": "Agrupa los tickets de ambos modos por fecha de creación y estado. Las tasas usan finalized + failed como denominador y son 0 si no hay resultados evaluables. El conteo incluye not_invoiceable y los demás estados."
          }
        },
        {
          "name": "Consultar consumo y créditos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/usage",
            "description": "Devuelve métricas del mes UTC actual, plan, saldo y fechas de recarga. Una métrica puede omitirse cuando todavía no se registra para el periodo."
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Listar destinos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations",
            "description": "Devuelve los destinos de la organización, incluidos los desactivados."
          }
        },
        {
          "name": "Crear un destino",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/destinations",
            "description": "Registra un destino activo y devuelve su secreto de firma. Guárdalo al recibir la respuesta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Facturas\",\n  \"url\": \"https://example.com/webhooks/taxo\",\n  \"events\": [\n    \"ticket.finalized\",\n    \"ticket.failed\",\n    \"invoice.finalized\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Consultar tipos de evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/event-types",
            "description": "Devuelve el catálogo de valores admitidos al suscribir un destino."
          }
        },
        {
          "name": "Consultar un destino",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}",
            "description": "Devuelve la configuración y la vista parcial del secreto."
          }
        },
        {
          "name": "Actualizar un destino",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}",
            "description": "Modifica los campos enviados. Usa active: true para reactivar un destino.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    \"ticket.finalized\",\n    \"ticket.failed\",\n    \"service.down\",\n    \"service.recovered\"\n  ],\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Desactivar un destino",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}",
            "description": "Desactiva el destino. Su configuración y su historial siguen disponibles."
          }
        },
        {
          "name": "Rotar secreto de firma",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}/rotate-secret",
            "description": "Reemplaza el secreto de firma y devuelve el nuevo. Actualiza el receptor para verificar los próximos envíos."
          }
        },
        {
          "name": "Enviar un evento de prueba",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}/test",
            "description": "Intenta entregar ticket.finalized con data.object.test: true. La respuesta indica el estado de entrega y el HTTP del receptor."
          }
        },
        {
          "name": "Listar entregas de un destino",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/destinations/{{destination_id}}/deliveries",
            "description": "Incluye el payload del evento y la respuesta registrada del receptor. Un destino sin entregas devuelve una lista vacía."
          }
        },
        {
          "name": "Listar entregas recientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/deliveries",
            "description": "Devuelve hasta 200 resúmenes de entregas de la organización, de la más reciente a la más antigua."
          }
        }
      ]
    }
  ]
}
